# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://oyyksxbizrzmzdtwlucn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only. Used ONLY by the daily reminder cron job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this site (used in email links and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (https://resend.com). Without a key, emails are logged as "simulated".
RESEND_API_KEY=
EMAIL_FROM="Talent-Vault Admissions <admissions@talent-vault.org>"

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Hero media. Comma-separated video URLs; defaults to /media/hero.mp4 plus the generated clips.
NEXT_PUBLIC_HERO_CLIPS=
